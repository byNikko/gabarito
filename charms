<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Imprimir - byNikko</title>
<style>
  /* Estilos para a visualização na tela do celular/computador */
  body {
    font-family: 'Arial Rounded MT Bold', sans-serif;
    background-color: #D8D4CE; /* Cor de fundo (tan) da sua marca */
    margin: 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .header-info {
    text-align: center;
    margin-bottom: 20px;
    color: #303331;
  }

  .btn-print {
    background-color: #FF7A00; /* Laranja da marca */
    color: #FFFFFF;
    border: none;
    padding: 12px 24px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 999px;
    cursor: pointer;
    margin-bottom: 30px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    transition: transform 0.1s ease;
  }

  .btn-print:active {
    transform: scale(0.95);
  }

  .image-container {
    background: #FFFFFF;
    padding: 20px;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(36,16,25,0.12);
    max-width: 100%;
    text-align: center;
  }

  .image-container img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Estilos exclusivos para a hora da impressão (Oculta botões e fundo) */
  @media print {
    body {
      background-color: #FFFFFF;
      padding: 0;
    }
    .header-info, .btn-print {
      display: none; /* Esconde texto e botão no papel */
    }
    .image-container {
      padding: 0;
      box-shadow: none;
      border-radius: 0;
    }
    .image-container img {
      width: 100%; /* Garante que a imagem preencha a folha */
    }
  }
</style>
</head>
<body>

  <div class="header-info">
    <h2>Catálogo byNikko</h2>
    <p>Clique no botão abaixo para imprimir a imagem em tamanho real.</p>
  </div>

  <!-- Botão que aciona a tela de impressão do navegador -->
  <button class="btn-print" onclick="window.print()">🖨️ Imprimir Imagem</button>

  <div class="image-container">
    <!-- COLOQUE O LINK DA SUA IMAGEM AQUI -->
    <img src="COLOQUE_SEU_LINK_AQUI.png" alt="Imagem para impressão byNikko">
  </div>

</body>
</html>
